{
    "include": [
        "src/**/*",
        "test/**/*",
        "example/**/*",
        "scripts/**/*",
        "openapi-ts.config.ts"
    ],
    "exclude": [
        "node_modules",
    ],
    "compilerOptions": {
        "types": [ "node" ],
        "outDir": "dist",
        "rootDir": ".",
        "module": "es2022",
        "target": "es2022",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "allowJs": true,
        "declaration": true,
        "checkJs": false,
        "strict": true,
        "alwaysStrict": true,
        "noImplicitAny": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "strictNullChecks": false,
        "skipLibCheck": true,
    }
}
